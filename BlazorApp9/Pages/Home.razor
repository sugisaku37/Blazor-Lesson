@page "/"

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<hr />

<input type="text" placeholder="名前を入力してください" @bind-value="Name" />
<button @onclick="btnDisplay_Click">メッセージを表示</button>
<p>メッセージ：@Message</p>

@code {
    private string Name { get; set; } = string.Empty;
    private string Message { get; set; } = string.Empty;

    private void btnDisplay_Click()
    {
        Message = $"こんにちは、{Name}さん！ " + $"現在時刻は{DateTime.Now.ToString("HH:mm:ss")}です。";
    }
}