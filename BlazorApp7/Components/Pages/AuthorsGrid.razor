@using BlazorApp7.Data
@using Microsoft.AspNetCore.Components.QuickGrid

@if(Authors == null)
{
    <div>データ読み込み中...</div>
}
else
{
    <div>
        <QuickGrid Items="@Authors" Pagination="@paginationState">
            <PropertyColumn Title="著者ID" Property="@(a => a.AuthorId)" Sortable="true" />
            <TemplateColumn Title="著者名" 
                Sortable="true" 
                SortBy="@(GridSort<Author>.ByAscending(a => a.AuthorFirstName).ThenAscending(a => a.AuthorLastName))">
                    @(context.AuthorFirstName) @(context.AuthorLastName)
            </TemplateColumn>
            <PropertyColumn Title="電話番号" Property="@(a => a.Phone)" Sortable="true" />
            <PropertyColumn Title="州" Property="@(a => a.State)" Sortable="true" />
            <TemplateColumn Title="契約有無" Sortable="true" SortBy="@(GridSort<Author>.ByAscending(a => a.Contract))">
                <input type="checkbox" disabled value="@(context.Contract)" />
                @(context.Contract ? "契約あり" : "契約なし")
            </TemplateColumn>
        </QuickGrid>
    </div>

    <Paginator State="@paginationState" />
}

@code {
    [Parameter]
    public IQueryable<Author>? Authors { get; set; }
    
    private readonly PaginationState paginationState = new PaginationState()
    {
        ItemsPerPage = 10
    };
}